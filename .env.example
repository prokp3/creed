# Copy this file to .env and fill it in. Never commit .env.
# Everything here is server side. None of it ever reaches the browser.

# Where your training data comes from: garmin (the default) or intervals, for COROS, Polar, Suunto, Wahoo and other
# watches that sync to intervals.icu.
# CREED_DATA_SOURCE=intervals

# intervals.icu only: your API key, from intervals.icu Settings, Developer Settings. It doesn't expire.
# INTERVALS_API_KEY=

# Garmin Personal API key, from https://connect.garmin.com/app/settings/personalApiToken
# Leave blank if you saved it with: python tools/garmin_probe.py --save-key
GARMIN_PERSONAL_API_KEY=

# Postgres connection string
DATABASE_URL=

# The app's one address, such as https://your-app.vercel.app. Passkeys are tied to it for good, so choose it before
# you register one. tools/dev_api.py sets this for you on your own computer.
CREED_ORIGIN=

# Opens passkey registration. A real address needs at least 32 characters. Make one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CREED_SETUP_SECRET=

# Protects the scheduled sync route. Make one the same way. Vercel requires this exact name.
CRON_SECRET=

# Optional. Used to work out today's date where the time zone in Settings isn't available.
# CREED_TIMEZONE=Asia/Kolkata

# Tests only: point the clients at fake servers.
# GARMIN_PERSONAL_API_BASE_URL=
# INTERVALS_BASE_URL=
